{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"lib": ["es2022", "dom", "dom.iterable"],
		"moduleResolution": "node",
		"strict": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"outDir": "./dist",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"paths": {
			"monaco-editor": ["../../out/monaco-editor/esm/vs/editor/editor.api.d.ts"]
		}
	},
	"include": ["src/**/*", "demo/**/*", "sample/**/*"],
	"exclude": ["node_modules"]
}
